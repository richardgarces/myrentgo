# Plataforma — observabilidad (Prometheus + Grafana)
# Copiar: cp .env.monitoring.example .env.monitoring && chmod 600 .env.monitoring
#
# Requiere MyRent Go en producción con red Docker: myrentgo-prod
#   ./scripts/deploy-prod.sh

# Identidad de la app (labels Prometheus / Grafana)
APP_ID=myrentgo
APP_ENV=prod

# Token compartido con la API (mismo valor en .env de la app)
# Generar: openssl rand -base64 32
METRICS_SCRAPE_TOKEN=CHANGE_ME-use-openssl-rand-base64-32

# Grafana (solo localhost; no exponer a Internet sin auth adicional)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME-strong-password

# Puertos en el host (bind 127.0.0.1)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
ALERTMANAGER_PORT=9093

# ── Alertmanager — notificaciones (configura al menos correo o Telegram) ───────

# Correo vía SMTP (Brevo, SendGrid, Gmail — mismo patrón que la app)
ALERTMANAGER_SMTP_HOST=smtp-relay.brevo.com
ALERTMANAGER_SMTP_PORT=587
ALERTMANAGER_SMTP_USER=90a030001@smtp-brevo.com
ALERTMANAGER_SMTP_PASSWORD=CHANGE_ME-clave-smtp-desde-panel-brevo
ALERTMANAGER_SMTP_FROM=alerts@meincart.com
ALERTMANAGER_EMAIL_TO=admin@meincart.com

# Telegram (opcional — bot + chat_id donde recibir alertas)
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
ALERTMANAGER_TELEGRAM_CHAT_ID=
