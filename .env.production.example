# MyRent Go — plantilla de variables para PRODUCCIÓN
# Copiar a .env en el servidor (NUNCA commitear .env con secretos reales):
#   cp .env.production.example .env
#   nano .env   # reemplazar todos los CHANGE_ME
#
# Generar secretos:
#   openssl rand -base64 32    # JWT_SECRET
#   openssl rand -base64 24    # MONGO_ROOT_PASSWORD

# ── Entorno ───────────────────────────────────────────────────────────────────
APP_ENV=production
APP_PORT=7070
APP_NAME="MyRent Go"

# Dominio público (HTTPS). Caddy usa DOMAIN; la app usa FRONTEND_URL para enlaces de correo.
# Subdominio recomendado (ver docs/DESPLIEGUE_PRODUCCION_SUBDOMINIO.md):
DOMAIN=rent.meincart.com
FRONTEND_URL=https://rent.meincart.com
# URL pública de la API (mismo host si Caddy enruta /api; o https://api.meincart.com si usas host separado)
BASE_URL=https://rent.meincart.com

# CORS: solo orígenes de producción (sin espacios, separados por coma)
CORS_ORIGINS=https://rent.meincart.com

# Certificado Let's Encrypt:
# - Con Caddy de docker-compose.prod.yml: ACME_EMAIL aquí.
# - Con kit ubuntu (platform-caddy): el email va en platform/caddy/.env (ACME_EMAIL).
ACME_EMAIL=admin@meincart.com

# Borde (opcional): EDGE=platform|builtin|auto  — ver scripts/deploy-prod.sh
# En BMAX con platform-caddy ya levantado: EDGE=platform ./scripts/deploy-prod.sh

# ── JWT ───────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Generar: openssl rand -base64 32
JWT_SECRET=CHANGE_ME-use-openssl-rand-base64-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=my-rent-go

# ── MongoDB (autenticación obligatoria en producción) ─────────────────────────
MONGODB_DATABASE=myrent
MONGO_ROOT_USER=myrent_admin
# Generar: openssl rand -base64 24
MONGO_ROOT_PASSWORD=CHANGE_ME-use-openssl-rand-base64-24
# URI usada por la API. Si el password tiene / + @ # etc., debe ir URL-encoded.
# Generar con: ./scripts/prod-prepare-env.sh  (opción 3 del prod-menu)
# Ejemplo sin caracteres especiales:
MONGODB_URI=mongodb://myrent_admin:CHANGE_ME-use-openssl-rand-base64-24@mongodb:27017/myrent?authSource=admin

# ── Seguridad ─────────────────────────────────────────────────────────────────
MFA_ENABLED=true
BCRYPT_COST=12
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# Intentos de login por IP en la ventana indicada
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=1m

# ── Documentos (filesystem + metadatos en MongoDB) ─────────────────────────────
# Ruta dentro del contenedor API (volumen api_storage montado en /app/storage)
DOCUMENTS_PATH=/app/storage/documents
MAX_UPLOAD_MB=30

# ── Correo SMTP (producción — NO usar Mailpit) ────────────────────────────────
# Camino por defecto: SMTP gratuito (Brevo / SendGrid / Gmail).
# Checklist día 1: docs/DIA1_PRODUCCION_APP_MEINCART.md
# Host Ubuntu genérico (opcional): ubuntu/README.md (./push-to-server.sh + bootstrap.sh)
# Detalle SPF/DKIM: docs/Cloudflare/correo.md
# Mailcow (opcional, futuro): docs/Cloudflare/mailcow.md
## Brevo — cuenta meincart.com (panel: SMTP y API → Claves SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=90a030001@smtp-brevo.com
SMTP_PASSWORD=CHANGE_ME-clave-smtp-desde-panel-brevo
SMTP_FROM=noreply@meincart.com
SMTP_FROM_NAME="MyRent Go"
# SendGrid: SMTP_HOST=smtp.sendgrid.net  SMTP_USER=apikey  SMTP_PASSWORD=SG....
# Gmail:    SMTP_HOST=smtp.gmail.com     SMTP_FROM=tu@gmail.com (sin Workspace)

EMAIL_SCHEDULER_ENABLED=true
EMAIL_SCHEDULER_INTERVAL=24h

# ── Monitoreo y métricas ──────────────────────────────────────────────────────
SYSTEM_LOG_MAX_ENTRIES=5000
METRICS_ENABLED=true
# En producción debe ser true: /metrics requiere JWT de admin/owner o METRICS_SCRAPE_TOKEN (Prometheus)
METRICS_PROTECTED=true
# Token para Prometheus (mismo valor en deploy/platform/.env.monitoring). Generar: openssl rand -base64 32
METRICS_SCRAPE_TOKEN=CHANGE_ME-use-openssl-rand-base64-32
METRICS_REFRESH_INTERVAL_SECS=60

# ── Notificaciones opcionales ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_URL=
