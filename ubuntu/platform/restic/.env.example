# =============================================================================
# Restic — backups cifrados off-site (platform/restic)
# NO es un contenedor 24/7: es CLI + .env + cron.
# Copia: cp .env.example .env && chmod 600 .env
# =============================================================================

APP_ID=platform
APP_ENV=prod

# RESTIC_REPOSITORY: destino del repositorio.
# Backblaze B2 ejemplo:
#   s3:https://s3.us-west-004.backblazeb2.com/mi-bucket/platform-restic
# MinIO local (desde el host):
#   s3:http://127.0.0.1:9000/platform-restic
# Amazon S3:
#   s3:s3.amazonaws.com/mi-bucket/platform-restic
RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/CHANGE_ME-bucket/platform-restic

# RESTIC_PASSWORD: contraseña del repositorio (cifrado). Si la pierdes, NO recuperas datos.
# Guárdala en un gestor de contraseñas off-site.
RESTIC_PASSWORD=CHANGE_ME-strong-restic-password

# Credenciales S3 / B2 / MinIO (variables estándar AWS para restic)
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1

# Política de retención (restic forget --prune)
RESTIC_KEEP_DAILY=30
RESTIC_KEEP_WEEKLY=12
RESTIC_KEEP_MONTHLY=12

# BACKUP_SRC: ruta local a respaldar (dumps, tarballs). El wrapper usa /opt/platform/backups/local
BACKUP_SRC=/opt/platform/backups/local
