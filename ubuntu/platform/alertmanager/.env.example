# =============================================================================
# Alertmanager — notificaciones (platform/alertmanager)
# Copia: cp .env.example .env && chmod 600 .env
# Luego: ../../scripts/../  o regenera alertmanager.yml con el script render
# =============================================================================

APP_ID=platform
ALERTMANAGER_PORT=9093

# --- Correo SMTP (opcional; misma cuenta Brevo/SendGrid que la app) ---
# ALERTMANAGER_SMTP_HOST: servidor SMTP de salida
ALERTMANAGER_SMTP_HOST=smtp-relay.brevo.com
# ALERTMANAGER_SMTP_PORT: normalmente 587 (STARTTLS)
ALERTMANAGER_SMTP_PORT=587
# ALERTMANAGER_SMTP_USER / PASSWORD: login SMTP del proveedor
ALERTMANAGER_SMTP_USER=CHANGE_ME@smtp-brevo.com
ALERTMANAGER_SMTP_PASSWORD=CHANGE_ME-smtp-key
# ALERTMANAGER_SMTP_FROM: remitente visible de las alertas
ALERTMANAGER_SMTP_FROM=alerts@example.com
# ALERTMANAGER_EMAIL_TO: destinatario (tu correo)
ALERTMANAGER_EMAIL_TO=admin@example.com

# --- Telegram (opcional) ---
# ALERTMANAGER_TELEGRAM_BOT_TOKEN: token de @BotFather
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
# ALERTMANAGER_TELEGRAM_CHAT_ID: id numérico del chat (getUpdates)
ALERTMANAGER_TELEGRAM_CHAT_ID=

# REPEAT_INTERVAL_WARNING: cada cuánto reenviar warning sin resolver (ej. 4h)
REPEAT_INTERVAL_WARNING=4h
# REPEAT_INTERVAL_CRITICAL: reenvíos critical (ej. 1h)
REPEAT_INTERVAL_CRITICAL=1h
