# =============================================================================
# Redis — variables de entorno (platform/redis)
# Copia: cp .env.example .env && chmod 600 .env
# =============================================================================

# --- Identidad ---
# APP_ID: nombre corto del stack en Docker (prefijo de contenedores/volúmenes).
# Úsalo si compartes un host entre varias apps; ejemplo: inventory, shop, platform.
APP_ID=platform

# --- Escucha ---
# REDIS_PORT: puerto en el HOST (bind solo localhost por seguridad).
# Dentro de Docker otros contenedores usan: platform-redis:6379 (nombre del servicio).
# NO abras este puerto en UFW hacia Internet.
REDIS_PORT=6379

# --- Autenticación ---
# REDIS_PASSWORD: contraseña obligatoria (comando AUTH). Genera con:
#   openssl rand -base64 24
# Vacía = inseguro; solo aceptable en labs aislados.
REDIS_PASSWORD=CHANGE_ME-openssl-rand-base64-24

# --- Recursos ---
# REDIS_MAXMEMORY: límite de RAM del proceso Redis (ej. 256mb, 1gb).
# Cuando se alcanza, se aplica la política MAXMEMORY_POLICY.
REDIS_MAXMEMORY=256mb

# REDIS_MAXMEMORY_POLICY:
#   allkeys-lru  — evicta las keys menos usadas (cache típico)
#   noeviction   — rechaza escrituras al llenarse (colas / datos críticos)
#   volatile-lru — solo keys con TTL
REDIS_MAXMEMORY_POLICY=allkeys-lru

# --- Persistencia ---
# REDIS_APPENDONLY: "yes" = AOF (más durable); "no" = solo RDB periódico.
# Para cache desechable puedes poner no; para colas/sesiones, yes.
REDIS_APPENDONLY=yes
