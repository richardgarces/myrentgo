# MyRent Go — configuración de pentest local (copiar a config.env)
# Alcance: solo localhost — NO usar contra sistemas externos.

# Objetivos
TARGET_API=http://localhost:7070
TARGET_FRONTEND=http://localhost:4000
TARGET_MONGO_HOST=localhost
TARGET_MONGO_PORT=27017

# Credenciales de prueba — cuenta sin MFA creada por seed (gestor@test.local).
# Admin (admin / admin123) suele tener MFA; usar gestor para JWT y pruebas autenticadas.
# Si falta el usuario: ./myrent.sh bootstrap
TEST_USER=gestor@test.local
TEST_PASSWORD=pentest123

# Instalar gosec/govulncheck automáticamente si faltan (requiere go en PATH). 0 = no instalar.
AUTO_INSTALL_TOOLS=1

# Límites éticos (no destructivo)
BRUTE_FORCE_ATTEMPTS=8
REQUEST_TIMEOUT_SEC=10
MAX_UPLOAD_TEST_MB=35

# Rutas del proyecto (auto-detectadas si se dejan vacías)
# PROJECT_ROOT=/path/to/my-rent-go

# Herramientas opcionales (dejar vacío = buscar en PATH)
# GOSEC_BIN=gosec
# GOVULNCHECK_BIN=govulncheck
# GITLEAKS_BIN=gitleaks
# TRUFFLEHOG_BIN=trufflehog
# SEMGREP_BIN=semgrep
# NUCLEI_BIN=nuclei

# Informe
REPORT_LANG=es
SCANNER_NAME="MyRent Go Security Toolkit"
SCANNER_VERSION="1.0.0"
