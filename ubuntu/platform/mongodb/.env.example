# =============================================================================
# MongoDB — base documental (platform/mongodb)
# Copia: cp .env.example .env && chmod 600 .env
# =============================================================================

APP_ID=platform

# MONGO_PORT: puerto en localhost. Apps en Docker: platform-mongodb:27017
# NUNCA abras 27017 en UFW a Internet.
MONGO_PORT=27017

# MONGO_ROOT_USER: usuario root creado en el primer arranque (authSource=admin)
MONGO_ROOT_USER=mongo_admin

# MONGO_ROOT_PASSWORD: contraseña root. Genera:
#   openssl rand -base64 24
# Debe coincidir con la URI de las apps que conecten a esta instancia.
MONGO_ROOT_PASSWORD=CHANGE_ME-openssl-rand-base64-24

# MONGO_INITDB_DATABASE: base creada al inicializar (opcional; root sigue en admin)
# Ejemplo: appdb (cámbialo al nombre de tu aplicación)
MONGO_INITDB_DATABASE=appdb

# MONGO_IMAGE_TAG: versión de la imagen oficial mongo
MONGO_IMAGE_TAG=7

# Ejemplo de URI desde otro contenedor en platform-net:
# mongodb://mongo_admin:PASSWORD@platform-mongodb:27017/appdb?authSource=admin
