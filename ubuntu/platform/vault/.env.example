# =============================================================================
# Vault — secretos KV (platform/vault)
# Copia: cp .env.example .env && chmod 600 .env
# =============================================================================

APP_ID=platform

# VAULT_PORT: UI/API en el host (localhost). Interno Docker: platform-vault:8200
# NO publicar a Internet sin TLS + auth fuerte.
VAULT_PORT=8200

# VAULT_DEV_MODE: en este compose el servicio corre siempre en modo servidor
# (vault.hcl). Para laboratorio -dev, usa la imagen a mano; no pongas
# VAULT_DEV_ROOT_TOKEN en el entorno del contenedor en modo servidor.
VAULT_DEV_MODE=false

# VAULT_DEV_ROOT_TOKEN: solo documentación / lab -dev. NO lo inyecta el compose
# de producción (Vault lo rechaza fuera de -dev).
VAULT_DEV_ROOT_TOKEN=root

# VAULT_API_ADDR: URL que Vault anuncia a los clientes (cluster / UI).
VAULT_API_ADDR=http://127.0.0.1:8200

# Convención de paths KV (documentación, no se crea sola):
#   secret/{app}/backend
#   secret/{app}/{componente}
# Políticas AppRole: cada app solo lee su path.
