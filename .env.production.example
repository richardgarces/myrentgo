# MyRent Go — plantilla de variables para PRODUCCIÓN
# Copiar a .env en el servidor (NUNCA commitear .env con secretos reales):
#   cp .env.production.example .env
#   nano .env   # reemplazar todos los CHANGE_ME
#
# Generar secretos:
#   openssl rand -base64 32    # JWT_SECRET
#   openssl rand -base64 24    # MONGO_ROOT_PASSWORD

# ── Entorno ───────────────────────────────────────────────────────────────────
APP_ENV=production
APP_PORT=7070
APP_NAME=MyRent Go

# Dominio público (HTTPS). Caddy usa DOMAIN; la app usa FRONTEND_URL para enlaces de correo.
# Subdominio recomendado (ver docs/DESPLIEGUE_PRODUCCION_SUBDOMINIO.md):
DOMAIN=app.meincart.com
FRONTEND_URL=https://app.meincart.com
# URL pública de la API (mismo host si Caddy enruta /api; o https://api.meincart.com si usas host separado)
BASE_URL=https://app.meincart.com

# CORS: solo orígenes de producción (sin espacios, separados por coma)
CORS_ORIGINS=https://app.meincart.com

# Certificado Let's Encrypt (opcional; Caddy usa el email del registro si está vacío)
ACME_EMAIL=admin@meincart.com

# ── JWT ───────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Generar: openssl rand -base64 32
JWT_SECRET=CHANGE_ME-use-openssl-rand-base64-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=my-rent-go

# ── MongoDB (autenticación obligatoria en producción) ─────────────────────────
MONGODB_DATABASE=myrent
MONGO_ROOT_USER=myrent_admin
# Generar: openssl rand -base64 24
MONGO_ROOT_PASSWORD=CHANGE_ME-use-openssl-rand-base64-24
# URI usada por la API (authSource=admin con usuario root de init)
MONGODB_URI=mongodb://myrent_admin:CHANGE_ME-use-openssl-rand-base64-24@mongodb:27017/myrent?authSource=admin

# ── Seguridad ─────────────────────────────────────────────────────────────────
MFA_ENABLED=true
BCRYPT_COST=12
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# Intentos de login por IP en la ventana indicada
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=1m

# ── Documentos (filesystem + metadatos en MongoDB) ─────────────────────────────
# Ruta dentro del contenedor API (volumen api_storage montado en /app/storage)
DOCUMENTS_PATH=/app/storage/documents
MAX_UPLOAD_MB=30

# ── Correo SMTP (producción — NO usar Mailpit) ────────────────────────────────
# Mailcow self-hosted: ver docs/Cloudflare/mailcow.md
# SendGrid / Gmail: ver comentarios en .env.example
SMTP_HOST=mail.meincart.com
SMTP_PORT=587
SMTP_USER=noreply@meincart.com
SMTP_PASSWORD=CHANGE_ME-smtp-password
SMTP_FROM=noreply@meincart.com
SMTP_FROM_NAME=MyRent Go

EMAIL_SCHEDULER_ENABLED=true
EMAIL_SCHEDULER_INTERVAL=24h

# ── Monitoreo y métricas ──────────────────────────────────────────────────────
SYSTEM_LOG_MAX_ENTRIES=5000
METRICS_ENABLED=true
# En producción debe ser true: /metrics requiere JWT de admin/owner
METRICS_PROTECTED=true
METRICS_REFRESH_INTERVAL_SECS=60

# ── Notificaciones opcionales ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_URL=
