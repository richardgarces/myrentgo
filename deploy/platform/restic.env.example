# Restic — backup off-site MyRent Go
# Copiar: cp restic.env.example restic.env && chmod 600 restic.env
#
# Prefijo en el repositorio: myrentgo/prod/
# Ejecutar: ./scripts/backup-restic.sh

APP_ID=myrentgo
APP_ENV=prod

# Contraseña del repositorio Restic (guardar en gestor de secretos)
RESTIC_PASSWORD=CHANGE_ME-strong-restic-password

# ── Destino S3-compatible (elige uno) ─────────────────────────────────────────

# Backblaze B2 (recomendado coste bajo):
# RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/my-bucket-name/myrentgo-restic
# AWS_ACCESS_KEY_ID=<b2-key-id>
# AWS_SECRET_ACCESS_KEY=<b2-application-key>

# MinIO en la misma red / plataforma:
# RESTIC_REPOSITORY=s3:http://minio:9000/myrentgo-restic
# AWS_ACCESS_KEY_ID=<minio-access-key>
# AWS_SECRET_ACCESS_KEY=<minio-secret-key>

# Amazon S3:
# RESTIC_REPOSITORY=s3:s3.amazonaws.com/my-bucket-name/myrentgo-restic
# AWS_ACCESS_KEY_ID=<aws-access-key>
# AWS_SECRET_ACCESS_KEY=<aws-secret-key>

RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/CHANGE_ME-bucket/myrentgo-restic
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# Retención (restic forget)
RESTIC_KEEP_DAILY=30
RESTIC_KEEP_WEEKLY=12
RESTIC_KEEP_MONTHLY=12

# Backup local antes de subir (mismo directorio que backup-prod.sh)
BACKUP_DIR=./backups
KEEP_DAYS=14
COMPOSE_FILE=docker-compose.prod.yml
