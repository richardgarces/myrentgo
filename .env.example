APP_ENV=development
APP_PORT=7070
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=myrent
JWT_SECRET=CHANGE-ME-use-openssl-rand-base64-32
CORS_ORIGINS=http://localhost:4000,http://localhost:5173
FRONTEND_URL=http://localhost:4000
MFA_ENABLED=true
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
BCRYPT_COST=12

# ── Correo (SMTP) ────────────────────────────────────────────────────────────
# Desarrollo local con Mailpit (recomendado):
#   docker compose -f docker-compose.mail.yml up -d
#   Bandeja: http://localhost:8025  |  SMTP: localhost:1025 (sin autenticación)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@myrent.local
SMTP_FROM_NAME=MyRent Go

# Scheduler de notificaciones por correo (revisa pagos de arriendo diariamente)
EMAIL_SCHEDULER_ENABLED=true
EMAIL_SCHEDULER_INTERVAL=24h

# Producción — SMTP real (Gmail, SendGrid, Mailcow, etc.):
# Requiere: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM
#
# Gmail (recomendado para pruebas):
#   1. Activa verificación en 2 pasos en tu cuenta Google
#   2. Crea una «Contraseña de aplicación» en https://myaccount.google.com/apppasswords
#   3. Usa esa contraseña de 16 caracteres (sin espacios) en SMTP_PASSWORD
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=tu-correo@gmail.com
#
# SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=noreply@tudominio.com
#
# Mailcow self-hosted (VPS dedicado mail.tudominio.com — ver docs/Cloudflare/mailcow.md):
# SMTP_HOST=mail.meincart.com
# SMTP_PORT=587
# SMTP_USER=noreply@meincart.com
# SMTP_PASSWORD=contraseña-del-buzón-en-mailcow
# SMTP_FROM=noreply@meincart.com
#
# Outlook / Microsoft 365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@outlook.com
# SMTP_PASSWORD=tu-contraseña-o-app-password
# SMTP_FROM=tu-correo@outlook.com
#
# (Comenta las variables Mailpit de arriba y descomenta las de tu proveedor)

TELEGRAM_BOT_TOKEN=
WHATSAPP_API_URL=
