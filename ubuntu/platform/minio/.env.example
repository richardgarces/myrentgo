# =============================================================================
# MinIO — object storage S3-compatible (platform/minio)
# Copia: cp .env.example .env && chmod 600 .env
# =============================================================================

APP_ID=platform

# MINIO_ROOT_USER: usuario administrador (access key raíz). Mínimo 3 caracteres.
# No es una app-key por bucket; crea users/policies en consola para cada app.
MINIO_ROOT_USER=minioadmin

# MINIO_ROOT_PASSWORD: contraseña root. Mínimo 8 caracteres. Genera fuerte:
#   openssl rand -base64 24
MINIO_ROOT_PASSWORD=CHANGE_ME-openssl-rand-base64-24

# MINIO_API_PORT: API S3 en el host (localhost). Apps en Docker usan platform-minio:9000
MINIO_API_PORT=9000

# MINIO_CONSOLE_PORT: consola web UI (localhost). No publicar a Internet sin proxy+auth.
MINIO_CONSOLE_PORT=9001

# MINIO_BUCKET_DEFAULT: nombre sugerido del primer bucket (crear manualmente o con mc).
# Convención multi-app: {app}-{env}-{proposito}  ej. inventory-prod-documents
MINIO_BUCKET_DEFAULT=app-prod-documents

# MINIO_REGION: región lógica (etiqueta S3). Puede ser us-east-1 aunque sea on-prem.
MINIO_REGION=us-east-1
