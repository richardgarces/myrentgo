# =============================================================================
# Caddy — reverse proxy de borde (platform/caddy)
# Copia: cp .env.example .env && chmod 600 .env
# =============================================================================

APP_ID=platform

# CADDY_HTTP_PORT / CADDY_HTTPS_PORT: puertos en el HOST.
# Si usas Cloudflare Tunnel hacia platform-caddy:80, puedes no publicar 443 al WAN
# y dejar solo bind localhost, o publicar 80/443 si el origen recibe tráfico directo.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ACME_EMAIL: email real para Let's Encrypt / ZeroSSL (avisos de caducidad).
# NO uses @example.com — Let's Encrypt lo rechaza (invalidContact).
# Usa tu Gmail o un alias del dominio, ej. admin@meincart.com
ACME_EMAIL=CHANGE_ME@tudominio.com

# SITE_ADDRESS: host público que Caddy atenderá (debe coincidir con DNS).
# Ejemplo: rent.meincart.com
SITE_ADDRESS=rent.meincart.com

# UPSTREAM: destino interno (contenedor:puerto) en platform-net.
# Ejemplo frontend: myapp-frontend:8080
# Ejemplo API+FE en un solo host path-based: edita Caddyfile.
UPSTREAM=host.docker.internal:8080
