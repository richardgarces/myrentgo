# =============================================================================
# Grafana — dashboards (platform/grafana)
# Copia: cp .env.example .env && chmod 600 .env
# =============================================================================

APP_ID=platform

# GRAFANA_PORT: UI en el host (localhost). Acceso remoto solo por túnel SSH.
GRAFANA_PORT=3001

# GRAFANA_ADMIN_USER: usuario administrador de Grafana
GRAFANA_ADMIN_USER=admin

# GRAFANA_ADMIN_PASSWORD: contraseña admin (cámbiala; no uses admin/admin)
#   openssl rand -base64 18
GRAFANA_ADMIN_PASSWORD=CHANGE_ME-strong-password

# GF_SERVER_ROOT_URL: URL pública que Grafana cree tener (enlaces, OAuth futuro)
GF_SERVER_ROOT_URL=http://127.0.0.1:3001

# PROMETHEUS_URL: datasource interno (nombre DNS del contenedor en platform-net)
PROMETHEUS_URL=http://platform-prometheus:9090

# GF_USERS_ALLOW_SIGN_UP: false = nadie se registra solo (recomendado producción)
GF_USERS_ALLOW_SIGN_UP=false
