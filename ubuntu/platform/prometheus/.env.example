# =============================================================================
# Prometheus — métricas (platform/prometheus)
# Copia: cp .env.example .env && chmod 600 .env
# =============================================================================

APP_ID=platform

# PROMETHEUS_PORT: UI/API en localhost. Interno: platform-prometheus:9090
PROMETHEUS_PORT=9090

# PROMETHEUS_RETENTION: cuánto tiempo guardar series temporales (ej. 15d, 30d).
# Más días = más disco.
PROMETHEUS_RETENTION=30d

# SCRAPE_TARGET: host:puerto del endpoint /metrics (reachable desde platform-net).
# Ejemplo: api:7070 si la app está en la misma red Docker, o IP del contenedor.
# Por defecto apunta a un target de ejemplo; edítalo a tu API.
SCRAPE_TARGET=host.docker.internal:7070

# SCRAPE_PATH: ruta de métricas (casi siempre /metrics)
SCRAPE_PATH=/metrics

# SCRAPE_SCHEME: http o https
SCRAPE_SCHEME=http

# METRICS_SCRAPE_TOKEN: Bearer token si /metrics está protegido.
# Déjalo vacío si las métricas son públicas en red interna (NO en Internet).
METRICS_SCRAPE_TOKEN=

# ALERTMANAGER_URL: host interno de Alertmanager (si está levantado).
ALERTMANAGER_URL=platform-alertmanager:9093
