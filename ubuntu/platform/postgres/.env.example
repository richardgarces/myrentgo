# =============================================================================
# PostgreSQL — SQL relacional (platform/postgres)
# Copia: cp .env.example .env && chmod 600 .env
# =============================================================================

APP_ID=platform

# POSTGRES_PORT: puerto en localhost. Apps Docker: platform-postgres:5432
# NUNCA abras 5432 a Internet.
POSTGRES_PORT=5432

# POSTGRES_USER: superusuario. NO puede empezar por "pg_" (reservado por PostgreSQL).
POSTGRES_USER=platform_admin

# POSTGRES_PASSWORD: contraseña. Genera: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME-openssl-rand-base64-24

# POSTGRES_DB: base de datos inicial creada al arrancar.
# Convención multi-app: {app}_{env}  ej. inventory_prod
# Mejor una BD lógica por app (no un esquema caótico compartido).
POSTGRES_DB=app_prod

# POSTGRES_IMAGE_TAG: versión mayor (15, 16, 17)
POSTGRES_IMAGE_TAG=16

# URI ejemplo:
# postgres://platform_admin:PASSWORD@platform-postgres:5432/app_prod
